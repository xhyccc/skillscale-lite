# ── Stage 1: Build Rust Binaries ──
FROM docker.m.daocloud.io/rust:1-bookworm AS builder
RUN apt-get update && apt-get install -y cmake clang libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/skillscale-rs
COPY skillscale-rs/ .
# Build release binaries for gateway, skill-server, and mcp-server
RUN cargo build --release

# ── Stage 2: Runtime Image (no OpenCode CLI needed — direct spawn) ──
FROM docker.m.daocloud.io/python:3.11-bookworm

# Install runtime dependencies (OpenSSL for rdkafka)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 ca-certificates curl bash procps && \
    rm -rf /var/lib/apt/lists/*

# Copy Rust binaries from builder
COPY --from=builder /usr/src/skillscale-rs/target/release/gateway /usr/local/bin/gateway
COPY --from=builder /usr/src/skillscale-rs/target/release/skill-server /usr/local/bin/skill-server
COPY --from=builder /usr/src/skillscale-rs/target/release/mcp-server /usr/local/bin/mcp-server

WORKDIR /app

# Copy Python requirements and install
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt

# Copy skill definitions (scripts/ and .claude/ no longer needed)
COPY skills/ /app/skills/

ENV SKILLSCALE_ROOT=/app

# Default entrypoint (overridden by docker-compose)
CMD ["gateway"]
