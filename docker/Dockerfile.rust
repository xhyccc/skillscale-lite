# ── Stage 1: Build Rust Binaries ──
FROM docker.m.daocloud.io/rust:1-bookworm AS builder
RUN apt-get update && apt-get install -y cmake clang libssl-dev pkg-config && rm -rf /var/lib/apt/lists/*
WORKDIR /usr/src/skillscale-rs
COPY skillscale-rs/ .
# Build only the gateway binary (skill-server runs natively, not in Docker)
RUN cargo build --release -p gateway

# ── Stage 2: Minimal runtime image (gateway is a pure Rust binary) ──
FROM docker.m.daocloud.io/debian:bookworm-slim

# Install runtime dependencies (OpenSSL for rdkafka TLS)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 ca-certificates curl && \
    rm -rf /var/lib/apt/lists/*

# Copy gateway binary from builder (skill-server runs natively)
COPY --from=builder /usr/src/skillscale-rs/target/release/gateway /usr/local/bin/gateway

WORKDIR /app

# Default entrypoint
CMD ["gateway"]
